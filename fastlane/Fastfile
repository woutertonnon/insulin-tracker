default_platform(:ios)

PROJECT = "InsulinTracker.xcodeproj"
SCHEME  = "InsulinTracker-iOS"

def app_ids
  [ENV["APP_IDENTIFIER_IOS"], ENV["APP_IDENTIFIER_WATCH"]]
end

def load_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  before_all do
    setup_ci # creates a temporary keychain on CI runners
    load_api_key
  end

  # Run ONCE (via the "Set up signing" workflow) to create the distribution
  # certificate + App Store profiles and push them, encrypted, to the `certs`
  # branch of this repo.
  desc "Create/refresh signing assets on the certs branch"
  lane :signing_bootstrap do
    match(type: "appstore", app_identifier: app_ids, readonly: false)
  end

  # Build the app with the match-managed distribution profiles and upload it
  # to TestFlight.
  desc "Build and upload to TestFlight"
  lane :beta do
    match(type: "appstore", app_identifier: app_ids, readonly: true)

    build_number = ENV["GITHUB_RUN_NUMBER"] || "1"

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["DEVELOPMENT_TEAM"],
        provisioningProfiles: {
          ENV["APP_IDENTIFIER_IOS"]   => "match AppStore #{ENV['APP_IDENTIFIER_IOS']}",
          ENV["APP_IDENTIFIER_WATCH"] => "match AppStore #{ENV['APP_IDENTIFIER_WATCH']}"
        }
      }
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end

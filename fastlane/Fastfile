default_platform(:ios)

PROJECT = "InsulinTracker.xcodeproj"
SCHEME  = "InsulinTracker-iOS"

def load_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  before_all do
    setup_ci # creates a temporary keychain on CI runners
    load_api_key
  end

  # Build the app and upload it to TestFlight.
  # Signing is fully automatic: Xcode creates/downloads a cloud-managed
  # distribution certificate and App Store profiles using the API key
  # (-allowProvisioningUpdates). No certs repo, no match.
  desc "Build and upload to TestFlight"
  lane :beta do
    build_number = ENV["GITHUB_RUN_NUMBER"] || "1"

    # Credentials for xcodebuild's cloud-managed signing (-allowProvisioningUpdates).
    # These let Xcode authenticate to Apple and create the distribution cert +
    # App Store profiles on the fly. fastlane's API key alone does NOT reach the
    # xcodebuild archive step, so we pass it explicitly here.
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{ENV['ASC_KEY_PATH']}",
      "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
      "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
    ].join(" ")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']} #{auth}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["DEVELOPMENT_TEAM"]
      }
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end

// ===========================================================================
//  EDIT THESE THREE VALUES, then commit. Everything else derives from them.
// ===========================================================================

// Your Apple Developer Team ID (App Store Connect → Membership → Team ID).
DEVELOPMENT_TEAM = REPLACE_TEAM_ID

// The iOS app bundle id. Must be globally unique and registered on the portal.
IOS_APP_BUNDLE_ID = com.REPLACE_ME.insulintracker

// The watch app bundle id. Convention: <iOS id>.watchkitapp
WATCH_APP_BUNDLE_ID = com.REPLACE_ME.insulintracker.watchkitapp
